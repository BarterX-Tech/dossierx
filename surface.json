{
  "commands": [
    {
      "path": "build-order lock",
      "short": "Lock --module's proposed build-order artifact, snapshotting a content-hash baseline",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--module",
        "--reason"
      ]
    },
    {
      "path": "build-order propose",
      "short": "Propose (and write) a build-order artifact for --module (refused unless every claim in it is locked)",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--module"
      ]
    },
    {
      "path": "build-order show",
      "short": "Print --module's build order: the machine envelope, a phase table, or one mermaid flowchart per phase",
      "flags": [
        "--config",
        "--format",
        "--module"
      ]
    },
    {
      "path": "build-order status",
      "short": "Show --module's build-order artifact state: proposed/locked/stale and coverage",
      "flags": [
        "--config",
        "--format",
        "--module"
      ]
    },
    {
      "path": "check",
      "short": "Run lint, catalog, render and the lock-ledger gate in one shot, stopping at first failure; --validate for a read-only run, --staged to judge the git index",
      "flags": [
        "--config",
        "--format",
        "--staged",
        "--validate"
      ]
    },
    {
      "path": "claim flag",
      "short": "Flag a locked claim as needing reaudit, with an explicit before/after and reason",
      "flags": [
        "--claim-says",
        "--config",
        "--dry-run",
        "--format",
        "--now-does",
        "--reason"
      ]
    },
    {
      "path": "claim link",
      "short": "Link --file (optionally at --symbol) to --claim as its implementation (immediate, no confirm step)",
      "flags": [
        "--claim",
        "--config",
        "--dry-run",
        "--file",
        "--format",
        "--module",
        "--symbol"
      ]
    },
    {
      "path": "claim list",
      "short": "List claims, optionally filtered by review state, migration note, code drift, facet, module, or a fuzzy --match",
      "flags": [
        "--config",
        "--drifted",
        "--facet",
        "--format",
        "--match",
        "--migrated",
        "--module",
        "--review-pending"
      ]
    },
    {
      "path": "claim lock",
      "short": "Lock one or more draft claims (refused if lint fails); --reason records the human approval it executes",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--proposal",
        "--reason",
        "--semantic-conflict"
      ]
    },
    {
      "path": "claim migrate-lock-policy",
      "short": "Adopt the local-approval lock policy without rewriting existing approvals",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "claim new",
      "short": "Author a new DRAFT claim (the sanctioned alternative to hand-writing claim YAML)",
      "flags": [
        "--body",
        "--build-role",
        "--config",
        "--dry-run",
        "--file",
        "--format",
        "--governed-by",
        "--governed-reason",
        "--layout",
        "--mirrors",
        "--rests-on",
        "--section"
      ]
    },
    {
      "path": "claim reaudit",
      "short": "Propose (and, with --confirm and --reason, apply) a diff for a review_pending claim",
      "flags": [
        "--config",
        "--confirm",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "claim show",
      "short": "Report one claim's full state in a single call: lifecycle, both edge directions, code links, discussion, and the legal next actions",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "claim unlock",
      "short": "Unlock a locked claim back to draft; --reason records the human approval it executes",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "comment add",
      "short": "Open a new comment thread on a claim",
      "flags": [
        "--as",
        "--body",
        "--config",
        "--dry-run",
        "--format"
      ]
    },
    {
      "path": "comment inbox",
      "short": "Every open comment thread in the project, in one call — what the human left for you",
      "flags": [
        "--config",
        "--format",
        "--since"
      ]
    },
    {
      "path": "comment list",
      "short": "List the comment threads on a claim (--open for unresolved only)",
      "flags": [
        "--config",
        "--format",
        "--open"
      ]
    },
    {
      "path": "comment reply",
      "short": "Add a reply to an open comment thread",
      "flags": [
        "--as",
        "--body",
        "--config",
        "--dry-run",
        "--format"
      ]
    },
    {
      "path": "serve",
      "short": "Serve the claims viewer with a localhost comment API",
      "flags": [
        "--config",
        "--format",
        "--port"
      ]
    },
    {
      "path": "skills export",
      "short": "Write the embedded skills in every form this repo uses: a SKILL.md tree, an idempotent AGENTS.md section, and a self-contained agent guide",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "theme export",
      "short": "Write a preset out as an editable theme file, or return its YAML when no path is given",
      "flags": [
        "--config",
        "--force",
        "--format"
      ]
    },
    {
      "path": "theme list",
      "short": "List every built-in theme preset with the token names it sets",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "track list",
      "short": "List every declared track with its claim counts and whether it is complete",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "track show",
      "short": "Assemble one track's document: its owned claims in full, and the claims it cites with their owning module, facet, and lock state",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "track status",
      "short": "Report whether a track is complete — every claim it owns and cites locked — and name every claim that is not",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "version",
      "short": "Print the dossierx version, commit, and build date",
      "flags": [
        "--config",
        "--format"
      ]
    }
  ],
