{
  "commands": [
    {
      "path": "brief list",
      "short": "List every brief with its path, summary, status and review state; --review-pending lists only the briefs awaiting review",
      "flags": [
        "--config",
        "--format",
        "--review-pending"
      ]
    },
    {
      "path": "brief lock",
      "short": "Lock a brief: record its content hash, the human's --reason and a baseline per rests_on claim",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "brief reaudit",
      "short": "Show what changed in the claims a locked brief rests on; --confirm --reason records the human's yes and refreshes the baselines",
      "flags": [
        "--config",
        "--confirm",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "brief show",
      "short": "Show one brief — its content, digest and status — by the path brief list prints or by its \u003cfolder\u003e.\u003cslug\u003e id",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "brief unlock",
      "short": "Unlock a locked brief back to draft; --reason stamps the release on its record",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "check",
      "short": "Run lint, catalog, render and the lock-ledger gate in one shot, stopping at first failure; --validate for a read-only run, --staged to judge the git index",
      "flags": [
        "--config",
        "--format",
        "--staged",
        "--validate"
      ]
    },
    {
      "path": "claim flag",
      "short": "Flag a locked claim as needing reaudit, with an explicit before/after and reason",
      "flags": [
        "--claim-says",
        "--config",
        "--dry-run",
        "--format",
        "--now-does",
        "--reason"
      ]
    },
    {
      "path": "claim link",
      "short": "Link --file (optionally at --symbol) to --claim as its implementation (immediate, no confirm step)",
      "flags": [
        "--claim",
        "--config",
        "--dry-run",
        "--file",
        "--format",
        "--module",
        "--symbol"
      ]
    },
    {
      "path": "claim list",
      "short": "List claims, optionally filtered by review state, code drift, facet, module, or a fuzzy --match",
      "flags": [
        "--config",
        "--drifted",
        "--facet",
        "--format",
        "--match",
        "--module",
        "--review-pending"
      ]
    },
    {
      "path": "claim lock",
      "short": "Lock one or more draft claims (refused if lint fails); --reason records the human approval it executes",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--proposal",
        "--reason",
        "--semantic-conflict"
      ]
    },
    {
      "path": "claim new",
      "short": "Author a new DRAFT claim (the sanctioned alternative to hand-writing claim YAML)",
      "flags": [
        "--body",
        "--config",
        "--dry-run",
        "--file",
        "--format",
        "--layout",
        "--rests-on",
        "--rests-on-none-reason",
        "--section",
        "--summary"
      ]
    },
    {
      "path": "claim reaudit",
      "short": "Propose (and, with --confirm and --reason, apply) a diff for a review_pending claim",
      "flags": [
        "--config",
        "--confirm",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "claim recover-approved-content",
      "short": "Recover approved wording from git history for approvals recorded before the ledger kept it",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "claim show",
      "short": "Report one claim's full state in a single call: lifecycle, both edge directions, code links, discussion, and the legal next actions",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "claim unlock",
      "short": "Unlock a locked claim back to draft; --reason records the human approval it executes",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "comment add",
      "short": "Open a new comment thread on a claim, or on a brief by its path",
      "flags": [
        "--as",
        "--body",
        "--config",
        "--dry-run",
        "--format"
      ]
    },
    {
      "path": "comment inbox",
      "short": "Every open comment thread in the project, in one call — what the human left for you",
      "flags": [
        "--config",
        "--format",
        "--since"
      ]
    },
    {
      "path": "comment list",
      "short": "List the comment threads on a claim or a brief (--open for unresolved only)",
      "flags": [
        "--config",
        "--format",
        "--open"
      ]
    },
    {
      "path": "comment reply",
      "short": "Add a reply to an open comment thread",
      "flags": [
        "--as",
        "--body",
        "--config",
        "--dry-run",
        "--format"
      ]
    },
    {
      "path": "constitution lock",
      "short": "Lock the constitution: record its content hash and the human's --reason in the lock store",
      "flags": [
        "--config",
        "--dry-run",
        "--format",
        "--reason"
      ]
    },
    {
      "path": "constitution show",
      "short": "Print the constitution's full text, its digest and its lock state",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "manifest list",
      "short": "Catalog every configured module from its manifest.yaml blurb (summaries only)",
      "flags": [
        "--config",
        "--format"
      ]
    },
    {
      "path": "manifest show",
      "short": "Print one module's manifest.yaml; --isolation adds the constitution, project claims index and claim summaries, --integration adds neighbors and what they provide",
      "flags": [
        "--config",
        "--format",
        "--integration",
        "--isolation"
      ]
    },
    {
      "path": "serve",
      "short": "Serve the claims viewer with a localhost comment API",
      "flags": [
        "--config",
        "--format",
        "--port"
      ]
    },
    {
      "path": "skills export",
      "short": "Write the embedded skills in every form this repo uses: a SKILL.md tree and an idempotent AGENTS.md section",
      "flags": [
        "--check",
        "--config",
        "--format"
      ]
    },
    {
      "path": "version",
      "short": "Print the dossierx version, commit, and build date",
      "flags": [
        "--config",
        "--format"
      ]
    }
  ],
