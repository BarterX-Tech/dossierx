.env
.env.*
*.pem
*.key
*id_rsa*
secrets/
*.secrets.yaml
go.work
go.work.sum
go.mod.local

# Claude Code local worktrees
.claude/worktrees/

# Lavish editor session state
.lavish/
# `make build` writes the binary here; the release procedure requires a clean tree.
/bin/
